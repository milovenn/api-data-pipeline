    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nreturn [{\n  json: {\n    status: 'success',\n    recordsWrittenOrUpdated: rows.length,\n    source: 'DummyJSON Users',\n    piiPolicy: 'whitelist-only',\n    dedupeKey: 'id',\n    finishedAt: new Date().toISOString(),\n  }\n}];"
      },
