      ],
      "id": "dc92dad7-3043-44ed-8bdd-f48948d7ad5d",
      "name": "Fetch All User Pages"
    },
    {
      "parameters": {
        "jsCode": "const pages = $input.all();\nconst users = [];\n\nfor (const page of pages) {\n  const body = page.json?.body ?? page.json;\n\n  if (Array.isArray(body?.users)) {\n    users.push(...body.users);\n  } else if (Array.isArray(body)) {\n    users.push(...body);\n  }\n}\n\nreturn users.map(user => ({ json: user }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -560,
        -20
      ],
      "id": "2a20ab84-668a-4184-90e1-981b94016268",
      "name": "Extract Users"
    },
    {
      "parameters": {
        "jsCode": "const clean = (value) => {\n  if (value === null || value === undefined) return '';\n  return String(value).trim().replace(/\\s+/g, ' ');\n};\n\nreturn $input.all().map(item => {\n  const u = item.json;\n\n  return {\n    json: {\n      ...u,\n      id: Number(u.id),\n      fullName: clean(`${u.firstName ?? ''} ${u.lastName ?? ''}`),\n      age: Number.isFinite(Number(u.age)) ? Number(u.age) : '',\n      gender: clean(u.gender).toLowerCase(),\n      company: clean(u.company?.name),\n      department: clean(u.company?.department),\n      jobTitle: clean(u.company?.title),\n      country: clean(u.address?.country),\n      role: clean(u.role).toLowerCase(),\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        -20
      ],
      "id": "6f2f170d-ee76-481d-842b-bf8da7cf21e3",
      "name": "Normalize"
    },
    {
      "parameters": {
        "jsCode": "// Security-by-whitelist: only these fields are allowed to leave this node.\n// Everything else is removed automatically, including email, phone,\n// password, SSN, bank, crypto, address, coordinates, IP/MAC/user-agent,\n// usernames and other source-only fields.\n\nconst allowedFields = [\n  'id',\n  'fullName',\n  'age',\n  'gender',\n  'company',\n  'department',\n  'jobTitle',\n  'country',\n  'role',\n];\n\nreturn $input.all().map(item => ({\n  json: Object.fromEntries(\n    allowedFields.map(key => [key, item.json[key] ?? ''])\n  )\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        -20
      ],
      "id": "bc1eed22-505d-49c2-b04c-2031cea67616",
      "name": "Remove Sensitive Data"
    },
    {
      "parameters": {
        "jsCode": "const seen = new Set();\nconst output = [];\n\nfor (const item of $input.all()) {\n  const id = item.json.id;\n\n  if (id === null || id === undefined || id === '') continue;\n\n  const key = String(id);\n  if (seen.has(key)) continue;\n\n  seen.add(key);\n  output.push(item);\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        -20
      ],
      "id": "74388db5-f3fc-436c-925f-6d0b8f0dd5d1",
      "name": "Deduplicate by ID"
    },
